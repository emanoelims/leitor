<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  header_mode="reader"
  class={[
    "free-page page-face-#{@face} page-size-#{@font_size}",
    !@show_numbers && "hide-paragraph-numbers",
    !@appearance["rail"] && "hide-page-map",
    @appearance["focus"] && "page-focus-mode",
    "page-leading-#{@appearance["leading"]} page-width-#{@appearance["width"]}",
    "page-align-#{@appearance["align"]} page-paras-#{@appearance["paras"]}"
  ]}
  style={"--page-text-size:#{@font_size}px"}
  context_title={@page_title}
  context_detail={if @dirty, do: "Unsaved", else: "Page"}
>
  <p :if={@appearance["focus"]} class="page-focus-hint">
    {gettext("Focus mode · Press F or Escape to leave")}
  </p>
  <:tools>
    <button
      :if={@text && !@editing}
      id="page-share"
      type="button"
      class="layer-button"
      phx-click="share-page"
      aria-label={gettext("Share page")}
      title={gettext("Share page")}
    ><.icon name="lucide-thin-arrow-up-right" class="size-[18px]" /></button>
    <button
      id="page-shortcuts"
      type="button"
      class="layer-button"
      phx-click="shortcuts"
      aria-label={gettext("Keyboard shortcuts")}
      title={gettext("Keyboard shortcuts")}
    ><.icon name="lucide-thin-keyboard" class="size-[18px]" /></button>
    <ReaderComponents.appearance
      face={@face}
      font_size={@font_size}
      numbers={@show_numbers}
      tab={@appearance_tab}
      preferences={@appearance}
    />
    <button
      :if={!@editing}
      id="page-edit"
      type="button"
      class="layer-button"
      phx-click="edit"
      aria-label={gettext("Edit page")}
      title={gettext("Edit page")}
    ><.icon name="lucide-thin-pen-line" class="size-[18px]" /></button>
    <button
      :if={!@editing}
      id="page-notebook"
      type="button"
      class={["layer-button", @notebook_open && "active"]}
      phx-click="notebook"
      aria-pressed={@notebook_open}
      aria-label={gettext("Page notebook")}
      title={gettext("Notes on this page")}
    ><.icon name="lucide-thin-book-open" class="size-[18px]" /></button>
    <button
      :if={@editing && @generation_id}
      id="page-ai-stop"
      type="button"
      class="workspace-header-action"
      phx-click="stop-page-generation"
      aria-label={gettext("Stop generating")}
    ><.icon name="lucide-square" class="size-3" /><span>{gettext("Stop")}</span></button>
    <button
      :if={@editing}
      id="page-save"
      type="submit"
      form="page-form"
      class="workspace-header-action workspace-header-primary"
      aria-label={gettext("Save & read")}
      title={gettext("Save & read · ⌘/Ctrl S")}
      phx-disable-with={gettext("Saving…")}
      disabled={!is_nil(@generation_id)}
    ><span>{gettext("Save & read")}</span><.icon name="lucide-thin-arrow-right" class="size-4" /></button>
  </:tools>
  <LeitorWeb.SharingComponents.panel
    :if={@sharing_open}
    share={@sharing_share}
    share_url={@sharing_url}
    members={@streams.page_collaborators}
    invite_form={@invite_form}
    sharing_form={@sharing_form}
  />
  <StudyComponents.dialog
    :if={@shortcuts_open}
    id="page-shortcut-dialog"
    title={gettext("A few helpful keys")}
    on_close={JS.push("shortcuts")}
  >
    <dl class="reading-shortcuts">
      <div :for={
        {key, action} <- [
          {"N", "Open or close your notebook"},
          {"F", "Enter or leave focus mode"},
          {"?", "Show keyboard shortcuts"},
          {"⌘ / Ctrl S", "Save while editing"},
          {"Esc", "Close a popup"},
          {"↑ / ↓ · Home / End", "Travel when the scroll map is focused"},
          {"Tab / Enter", "Move between and activate controls"}
        ]
      }>
        <dt><kbd>{key}</kbd></dt><dd>{t(action)}</dd>
      </div>
    </dl>
  </StudyComponents.dialog>
  <section
    :if={@generation_recovery && is_nil(@generation_id) && !@generation_applied}
    id="page-generation-recovery"
    class="generation-recovery"
    aria-label={gettext("Saved generation")}
  >
    <div>
      <.icon name="lucide-sparkles" class="size-4" />
      <p>
        {gettext("Your figure generation is saved.")}<small>{t(
          case @generation_recovery.status do
            "queued" -> "It is waiting for capacity. Credits are reserved only when it starts."
            "running" -> "It is still working. You can leave this page and return."
            "ready" -> "Your result is ready to add to the editor."
            _ -> "Your draft is safe. Continue from the saved request."
          end
        )}</small>
      </p>
    </div>
    <button
      id="page-generation-recover"
      type="button"
      class="workspace-header-action"
      phx-click="recover-generation"
    >
      {gettext("Recover generation")}<.icon name="lucide-arrow-right" class="size-4" />
    </button>
    <button
      :if={@generation_recovery.status not in ["running", "queued"]}
      id="page-generation-dismiss"
      type="button"
      class="icon-button"
      phx-click="dismiss-generation"
      aria-label={gettext("Dismiss saved generation")}
    >
      <.icon name="lucide-x" class="size-4" />
    </button>
  </section>
  <%= if @editing do %>
    <.form
      for={@form}
      id="page-form"
      phx-change="draft"
      phx-submit="save"
      class="page-editor-form"
    >
      <.input
        id="page-title"
        field={@form[:title]}
        aria-label={gettext("Page title")}
        placeholder={gettext("Untitled")}
        maxlength="180"
        class="page-title-input"
        required
      />
      <div
        id="page-editor"
        phx-hook="PageEditor"
        phx-update="ignore"
        data-draft-key={"#{@current_scope.user.id}:#{if @text, do: @text.id, else: "new"}"}
      >
        <p id="page-draft-recovered" class="notice" role="status" hidden>
          {gettext("Your unsaved draft was restored in this tab. Save it to keep it.")}
        </p>
        <.input id="page-body" field={@form[:body]} type="textarea" class="hidden" />
        <div id="page-editor-surface"></div>
        <WritingComponents.slash_menu />
        <WritingComponents.ai_composer />
      </div>
      <p :if={@error} role="alert" class="notice">{t(@error)}</p>
    </.form>
  <% else %>
    <div class="free-page-layout">
      <article class="free-page-document">
        <header class="free-page-heading">
          <p class="eyebrow">{gettext("Your own little corner")}</p><h1>{@page_title}</h1><p>
            {ngettext(
              "%{count} block",
              "%{count} blocks",
              length(@document.blocks)
            )}
          </p>
        </header>
        <div
          id="page-reading"
          phx-hook="PageReader"
          phx-update="ignore"
          data-marks={@marks_json}
          data-reading-key={"#{@current_scope.user.id}:#{@text.id}"}
          data-reading-version={Base.encode16(:crypto.hash(:sha256, @text.body), case: :lower)}
          class="page-prose"
          lang="en"
        >
          {Phoenix.HTML.raw(@document.html)}
        </div>
        <p class="page-end">{gettext("End of this page")} <span aria-hidden="true">✦</span></p>
      </article>
      <aside
        id="page-margin-root"
        class="page-margins"
        aria-label={gettext("Margin notes")}
        data-active={@active_mark_id || (@busy && "pending")}
      >
        <div :if={@mark_count == 0 && !@busy} class="page-margin-intro">
          <p>{gettext("Select a word or a passage.")}</p><p>
            {gettext("Define it, mark it, or keep a thought here.")}
          </p>
        </div>
        <p :if={@error} id="page-help-error" role="alert" class="notice">{t(@error)}</p>

        <ReaderComponents.pending_annotation
          :if={@busy && @pending && is_nil(@pending.mark_id)}
          id="page-pending-card"
          pending={@pending}
          answer={if @help_stream, do: @help_stream.answer, else: ""}
          document={@document}
        />
        <div id="page-margin-marks" phx-update="stream">
          <ReaderComponents.annotation
            :for={{id, mark} <- @streams.margin_marks}
            id={id}
            mark={mark}
            active={@active_mark_id == mark.id}
            document={@document}
            busy={@busy}
            pending={@pending}
            help_stream={@help_stream}
          />
        </div>
        <svg
          id="page-margin-connectors"
          phx-hook="PageMargin"
          phx-update="ignore"
          class="page-margin-connectors"
          aria-hidden="true"
        ></svg>
      </aside>
    </div>
    <ReaderComponents.citation_preview />
    <div
      id="page-scroll-rail"
      phx-hook="PageRail"
      phx-update="ignore"
      role="slider"
      aria-label={gettext("Position in the page")}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="0"
      tabindex="0"
    >
      <div class="page-rail-bars" aria-hidden="true"></div>
      <div class="page-rail-markers" aria-hidden="true"></div>
      <div class="page-rail-viewport" aria-hidden="true"></div>
    </div>
  <% end %>
  <aside
    :if={@notebook_open && !@editing}
    id="page-notebook-panel"
    class="page-notebook"
    aria-label={gettext("Notebook")}
    phx-window-keydown="notebook"
    phx-key="Escape"
  >
    <header>
      <div>
        <h2>{gettext("Notebook")}</h2><p>
          {ngettext("%{count} saved entry", "%{count} saved entries", @mark_count)}
        </p>
      </div><button
        id="copy-page-notebook"
        type="button"
        class="icon-button"
        aria-label={gettext("Copy notebook as Markdown")}
        phx-click={
          JS.dispatch("leitor:copy",
            detail: %{text: @notebook_markdown, status_id: "page-export-status"}
          )
        }
        disabled={@mark_count == 0}
      ><.icon name="lucide-copy" class="size-4" /></button>
      <button
        id="download-page-notebook"
        type="button"
        class="icon-button"
        aria-label={gettext("Download notebook as Markdown")}
        phx-click="export-notebook"
        phx-value-mode="download"
        disabled={@mark_count == 0}
      ><.icon name="lucide-download" class="size-4" /></button>
      <button
        id="close-page-notebook"
        type="button"
        class="icon-button"
        phx-click="notebook"
        aria-label={gettext("Close notebook")}
      ><.icon name="lucide-x" class="size-4" /></button>
    </header>
    <p id="page-export-status" phx-update="ignore" class="page-export-status" role="status"></p>
    <div class="notebook-filters" role="group" aria-label={gettext("Annotation types")}>
      <button
        :for={
          {kind, label} <- [
            {"all", "All"},
            {"highlight", "Highlights"},
            {"note", "Notes"},
            {"definition", "Definitions"},
            {"answer", "Questions"}
          ]
        }
        id={"notebook-filter-#{kind}"}
        type="button"
        class={[@notebook_filter == kind && "selected"]}
        phx-click="filter-notebook"
        phx-value-kind={kind}
        aria-pressed={@notebook_filter == kind}
      >{t(label)}</button>
    </div>
    <div id="page-notebook-marks" phx-update="stream" class="page-notebook-scroll">
      <div id="page-notebook-empty" class="hidden only:block notebook-empty-state">
        <.icon name="lucide-notebook-pen" class="size-8" /><h3>{gettext("Nothing here yet")}</h3><p>
          {gettext("Add a note or ask about a passage. It will stay here, in reading order.")}
        </p>
      </div>
      <article
        :for={{id, mark} <- @streams.notebook_marks}
        id={id}
        class={"page-notebook-entry mark-#{mark.kind}"}
      >
        <div class="row between">
          <button
            type="button"
            class="page-mark-meta"
            data-page-cite-mark={mark.id}
            phx-click="jump-mark"
            phx-value-id={mark.id}
          >¶{mark.block_index + 1} · {t(String.capitalize(mark.kind))}
          <.icon name="lucide-arrow-up-right" class="size-3" /></button><button
            :if={mark.kind == "note"}
            type="button"
            class="icon-button"
            aria-label={gettext("Edit note")}
            phx-click="edit-note"
            phx-value-id={mark.id}
          ><.icon name="lucide-pen-line" class="size-3" /></button>
          <button
            type="button"
            class="icon-button"
            aria-label={gettext("Remove annotation")}
            phx-click="remove-mark"
            phx-value-id={mark.id}
          ><.icon name="lucide-trash-2" class="size-3" /></button>
        </div>
        <blockquote class={"highlight-#{mark.color}"}>{mark.quote}</blockquote><h3 :if={
          mark.question
        }>
          {mark.question}
        </h3><div :if={mark.body != ""} class="page-answer">
          {answer_html(mark.body, @document)}
        </div>
        <div :for={reply <- mark.replies} id={"#{id}-reply-#{reply.id}"} class="page-follow-turn">
          <h4>{reply.question}</h4><div class="page-answer">
            {answer_html(reply.body, @document)}
          </div>
        </div>
        <button
          :if={String.length(mark.quote) <= 200}
          type="button"
          class="page-collect-word"
          phx-click="mark-to-pot"
          phx-value-id={mark.id}
        ><.icon name="hero-beaker" class="size-3" />{if mark.category == "word",
          do: gettext("Keep in a jar"),
          else: "#{String.capitalize(mark.category)} · Keep in a jar"}</button>
      </article>
    </div>
  </aside>
  <LeitorWeb.SelectionComponents.selection
    selection={@selection}
    editing={@editing}
    selection_mode={@selection_mode}
    selection_anchor={@selection_anchor}
    page_title={@page_title}
    busy={@busy}
    marker_color={@marker_color}
    editing_highlight_id={@editing_highlight_id}
    editing_highlight_color={@editing_highlight_color}
    note_form={@note_form}
    question_form={@question_form}
    pot_form={@pot_form}
    error={@error}
  />
</Layouts.app>
